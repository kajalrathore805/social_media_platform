= render :partial => "shared/post_nav"

.container.d-flex.justify-content-center.mt-5
  .p-4.border.rounded.shadow.bg-white{ style:"min-width: 400px;"}
    %h2 All followers
    %ul
      - @followers.each do |follow|
        %li 
          = link_to follow.follower.name, user_path(follow.user_id),class:"text-decoration-none text-dark"
    