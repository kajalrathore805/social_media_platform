
= render :partial =>  "shared/post_nav"
%body{ style: "margin:0;"}
  .container.mt-3
    %h3.text-center All Users
    %div.filter_by_name{style: 'margin-bottom: 20px ; float: right'}
      - select_options = options_for_select @users.map {|user| [user.name, user.id]}
      = select_tag 'filter_by_name', select_options,id: 'filter_by_name', include_blank: 'All users',data: { index_url: users_path(format: 'js')}
     
    %table.table.table-striped
      %thead
        %tr
          %th Id
          %th Name
          %th Email
          %th Contact
      %tbody#user_table
        = render partial: "user_row", locals: {users: @users}
/ = will_paginate @all_users


:javascript
  $(document).ready(function(){
    $("#filter_by_name").on("change", function(){
      $("#loader-spinner").show();
      
      let url = $(this).data('indexUrl') + '?filter_by_user_id=' + $(this).val();
      
      $.ajax({
        url: url,
        dataType: 'script'
      });
    });
  });



 


