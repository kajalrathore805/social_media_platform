/ = render :partial =>  "shared/post_nav"

.tab.users-container.d-flex.flex-column.mt-3.p-3.container-sm.align-items-center#nav-accounts-tab{ style: "gap: 30px;max-width: 590px;" }
  - @users.each do |user|
    .user-detail.d-flex.align-items-center.border.rounded.shadow-sm.w-100{ style: "gap: 10px;" }
      .user-image.m-2
        = link_to user_path(user) do
          - if user.image.attached?
            = image_tag user.image.variant(resize_to_limit: [200,200]), class: 'rounded-circle', width: '50', height: '50'
          - else
            %p no image
      .user-name.fw-semibold{ style: "flex-grow: 1" }
        = link_to user.name, user_path(user), class: 'text-decoration-none text-dark'
      