= render "shared/post_nav"

.posts-container.d-flex.flex-column.mt-3.p-3.container-sm.align-items-center{ style: "gap: 30px" }
  - @posts.each do |post|
    .post-container.d-flex.flex-column.p-3.border.rounded.shadow-sm.w-100{ style: "gap: 15px; max-width: 590px;" }
      .user-detail.d-flex.align-items-center.border.rounded.shadow-sm.w-100{ style: "gap: 10px;" }
        .user-image.m-2
          = link_to user_path(post.user_id) do
            = image_tag post.user.image.variant(resize_to_limit: [200,200]), class: 'rounded-circle', width: '50', height: '50'
        .user-name.fw-semibold{ style: "flex-grow: 1" }
          = link_to post.user.name, user_path(post.user_id), class: 'text-decoration-none text-dark'
        = render 'users/follow_button', user: post.user

      .post-detail
        .post-title.fs-4.fw-semibold
          = link_to post.title, post_path(post), class: 'text-decoration-none text-dark'
        .post-images.d-flex{ style: "gap: 5px" }
          - post.images.each do |image|
            .post-image
              = image_tag image.variant(resize_to_limit: [300,300]), size: "135x135"

      = render "posts/post_action", post: post

.modal.fade#commentModal
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        %h4.modal-title All Comments
        %button.btn-close{ type: "button", "data-bs-dismiss" => "modal" }

      .modal-body
        -# comment data here

      .modal-footer
        %button.btn.btn-danger{ type: "button", "data-bs-dismiss" => "modal" } Close

= will_paginate @posts

/ = javascript_include_tag "comment_modal"
