.comment#edit-comment{ style:"margin-bottom: 15px"}
  
  %div
    %strong Commenter:
    %span 
      = comment.user.name

  %div
    %strong Comment:
    %span 
      = comment.body

  %div
    - if comment.user_id ==  @current_user.id
      %span
        = link_to "Edit" , edit_post_comment_path(@post,comment.id),class: "btn btn-sm btn-secondary inline edit-comment"
     
      %span
        = link_to "Delete", [comment.post, comment],class:"btn btn-sm btn-danger delete-data", data: { turbo_method: :delete,
                      turbo_confirm: "Are you sure?",
                      turbo: false }