
%div
  - @notifications.each do |notification|
    .container.d-flex.justify-content-center.mt-2.notification
      .p-4.border.rounded.shadow.bg-white{ style: "min-width: 450px;" }
        %span{ style: "float: left;" }
          %b
            = link_to notification.actor.name, user_path(notification.actor), class: "text-decoration-none text-dark"
        %span{style: "text-align: center;"}
          = perform_action(notification)
        %span
          = link_to  delete_notification_path(id: notification.id),class:"delete-notification", data: { method: :delete, turbo: false } do
            %i.bi.bi-x-square.text-decoration-none.text-dark{ style: "float: right;" }
